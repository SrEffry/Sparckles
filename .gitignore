# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — el .env real NUNCA se sube (contiene DATABASE_URL y JWT_SECRET).
# Solo se versiona la plantilla .env.example.
.env*
!.env.example

# secretos / certificados sueltos
*.key
*.p12
*.pfx
secrets.json

# settings locales de Claude (no compartir)
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma
