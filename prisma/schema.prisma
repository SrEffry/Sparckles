// Esquema Sparkles — dominio contable/tributario (Colombia).
// Alcance: TODO se liga a un Usuario (data privada por usuario), según decisión del cliente.
// Reglas de producción: dinero en Decimal(18,2); documentos fiscales anulables (no borrables);
// numeración de factura secuencial garantizada por transacción.
//
// Entidades ya mapeadas del sitio actual están modeladas por completo. Nota/Asiento/Empleado/
// Nomina/DocumentoSoporte/Compra se agregarán al portar cada módulo (mapeo campo a campo).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================ Usuario / Auth ============================
model Usuario {
  id             String   @id @default(cuid())
  nombre         String
  apellido       String
  nombreCompleto String
  email          String   @unique
  password       String // hash bcrypt
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  empresas     Empresa[]
  clientes     Cliente[]
  productos    Producto[]
  facturas     Factura[]
  borradores   BorradorFactura[]
  terceros     Tercero[]
  notas        Nota[]
  empleados    Empleado[]
  nominas      Nomina[]
  compras      Compra[]
  asientos     Asiento[]
  soportes     DocumentoSoporte[]
  impuestos    Impuesto[]
  tesoreria    CuentaTesoreria[]
  comprobantes ComprobanteTesoreria[]
  consecutivos ConsecutivoDocumento[]
  retenciones  RetencionPracticada[]
  certificados CertificadoRetencion[]
  notasContab  NotaContabilidad[]
  configFact   ConfigFacturacion?
  mapaCuentas  MapaCuentas?

  @@map("usuarios")
}

// ============================ Empresa (wizard 4 pasos) ============================
model Empresa {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tipoEntidad String // 'juridica' | 'natural'
  estado      String @default("Activo") // 'Activo' | 'Inactivo'

  // Persona jurídica
  razonSocial String?
  nit         String?
  dv          String?

  // Persona natural
  nombres         String?
  apellidos       String?
  nombreCompleto  String?
  tipoDocumento   String?
  numeroDocumento String?

  // Contacto (compartido)
  telefono String?
  email    String?

  // Representante legal (solo jurídica)
  repNombres         String?
  repApellidos       String?
  repTipoDocumento   String?
  repNumeroDocumento String?
  repTelefono        String?
  repEmail           String?

  // Ubicación
  pais         String?
  departamento String?
  ciudad       String?
  direccion    String?
  codigoPostal String?

  // Tributario
  tarifaIvaRetenido          String?
  aplicaIva                  Boolean  @default(false)
  caracteristicasTributarias String[]

  @@index([usuarioId])
  @@map("empresas")
}

// ============================ Cliente ============================
model Cliente {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tipo           String // 'natural' | 'empresa'
  nombreCompleto String

  // Persona natural
  nombres         String?
  apellidos       String?
  tipoDocumento   String?
  numeroDocumento String?

  // Empresa
  razonSocial     String?
  nombreComercial String?
  nit             String?
  dv              String?
  personaContacto String?

  // Contacto
  telefono     String?
  email        String?
  direccion    String?
  ciudad       String?
  departamento String?

  // Retención (dirige el cálculo de retenciones en factura)
  esAgenteRetenedor Boolean @default(false)
  esAutorretenedor  Boolean @default(false)

  // ---- Identidad para exógena: vive en `Tercero`, no aquí ----
  //
  // Estos campos (tipo de documento DIAN, los cuatro de nombre separados, códigos DANE, país)
  // estuvieron un tiempo duplicados en esta tabla y NUNCA tuvieron formulario: eran columnas
  // muertas que ningún usuario podía llenar. Peor: un mismo NIT que fuera cliente y proveedor
  // tenía DOS identidades —una aquí y otra en `Tercero`— y la DIAN cruza el 1007 del receptor
  // contra el 1001 del pagador. Dos identidades para un NIT es un cruce que no cuadra.
  //
  // Ahora la identidad es UNA y está en `Tercero`. `Cliente` guarda la RELACIÓN COMERCIAL —los
  // datos que dirigen la facturación: si es agente retenedor, si es autorretenedor, su dirección
  // de facturación— y apunta a la identidad. Se crea o se enlaza solo, al guardar el cliente.
  tercero   Tercero? @relation(fields: [terceroId], references: [id], onDelete: SetNull)
  terceroId String?

  // Un cliente con facturas NO se borra: se inactiva. `Factura.clienteId` no tiene llave
  // foránea, así que borrarlo dejaba el id apuntando a nada y esas facturas desaparecían en
  // silencio de los extractos de exógena.
  activo Boolean @default(true)

  // Documento NORMALIZADO (solo dígitos, sin DV), duplicado de `nit`/`numeroDocumento` para
  // poder sostener la unicidad: la exógena agrupa el año entero por documento, y dos fichas del
  // mismo NIT producían dos identidades distintas —con direcciones y códigos DANE distintos—
  // sin que nada avisara. `Tercero` ya tenía esta red; `Cliente` no.
  documentoNormalizado String?

  @@unique([usuarioId, documentoNormalizado])
  @@index([usuarioId])
  @@map("clientes")
}

// ============================ Producto ============================
model Producto {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  codigo      String
  descripcion String
  unidad      String?
  comoCompra  String?
  comoVende   String?
  precioVenta Decimal @db.Decimal(18, 2)
  linea       String?

  // Tratamiento frente al IVA. Es una CATEGORÍA, no un porcentaje: exento (Art. 477 E.T., da
  // derecho a IVA descontable) y excluido (Art. 476, no lo da y su IVA va al costo) no son
  // tarifas, y meterlos en el mismo campo que un número fue el origen de la confusión.
  // 'gravado' | 'exento' | 'excluido' | 'no_gravado'
  tratamientoIva String @default("gravado")

  // Impuestos que aplica el producto. Vacío cuando el tratamiento no es 'gravado'.
  impuestos ProductoImpuesto[]

  // Tarifa heredada, en texto ("19%", "Exento"). Se conserva solo como respaldo de la
  // migración al catálogo de impuestos; NADA la lee para calcular. Se elimina cuando esté
  // confirmado que todos los productos quedaron bien clasificados.
  tarifaIva String?

  // Retención (nested `retencion` en el sitio actual)
  retAplica    Boolean  @default(false)
  retNombre    String?
  retTarifa    Decimal? @db.Decimal(6, 3)
  retCategoria String?
  retConcepto  String?

  @@unique([usuarioId, codigo])
  @@index([usuarioId])
  @@map("productos")
}

// ============================ Config de facturación (emisor + resolución DIAN) ============================
model ConfigFacturacion {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logo               String? @db.Text // base64
  razonSocial        String?
  nit                String?
  regimen            String?
  // Si el emisor NO es responsable de IVA, no puede cobrarlo: la factura se liquida con IVA 0.
  responsableIva     Boolean @default(true)
  direccion          String?
  ciudad             String?
  telefono           String?
  email              String?
  actividadEconomica String?
  pieFact            String?
  observaciones      String?

  // Art. 114-1 E.T.: exonera al empleador de salud (8,5%), SENA (2%) e ICBF (3%) por los
  // trabajadores que devenguen menos de 10 SMLMV. La caja de compensación (4%) y la pensión
  // (12%) NUNCA se exoneran. Quién califica es criterio del contador, así que se declara aquí
  // en vez de deducirse.
  exoneradoParafiscales Boolean @default(false)

  // Resolución DIAN.
  // La vigencia (expedición + vencimiento) es NOT NULL a propósito: es una regla fiscal y debe
  // sostenerla la BD, no la convención de que otro módulo haya validado bien. Sin vigencia no se
  // puede emitir, así que un nulo aquí sería una factura sin control de vigencia.
  resNumero        String?
  resFecha         String
  prefijo          String?
  numeracionDesde  Int?
  numeracionHasta  Int?
  numeracionActual Int?
  resVencimiento   String

  @@map("config_facturacion")
}

// ============================ Factura + items ============================
model Factura {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  numero           Int
  prefijo          String
  numeroCompleto   String
  fecha            String
  fechaVencimiento String?
  formaPago        String?
  medioPago        String?
  instrumentos     Json?
  observaciones    String?

  // Estado fiscal: 'emitida' | 'anulada' (nunca se borra).
  // La anulación se fecha: sin `fechaAnulacion` un periodo ya declarado deja de ser
  // reproducible. Si en julio se anula una factura de marzo, el filtro del bimestre
  // marzo-abril dejaría de devolver lo que se declaró en mayo.
  estado          String  @default("emitida")
  fechaAnulacion  String? // YYYY-MM-DD, hora Bogotá
  motivoAnulacion String?

  // Snapshot del cliente (inmutable al momento de emitir)
  clienteId                String?
  clienteNombre            String
  clienteTipo              String?
  clienteTipoDocumento     String?
  clienteNumeroDocumento   String?
  clienteDv                String?
  clienteTelefono          String?
  clienteEmail             String?
  clienteDireccion         String?
  clienteEsAgenteRetenedor Boolean @default(false)
  clienteEsAutorretenedor  Boolean @default(false)

  // Totales
  subtotal        Decimal @db.Decimal(18, 2)
  totalDescuentos Decimal @default(0) @db.Decimal(18, 2)
  // SOLO IVA. El Impuesto al Consumo va aparte: es otro tributo, con su propio formulario,
  // y NO es descontable para el comprador. Sumarlo aquí inflaba el IVA generado y el IVA por
  // pagar de Finanzas con un impuesto que no es IVA.
  iva             Decimal @default(0) @db.Decimal(18, 2)
  inc             Decimal @default(0) @db.Decimal(18, 2)
  otrosImpuestos  Decimal @default(0) @db.Decimal(18, 2)
  // `retenciones` es SOLO ReteFuente. ReteIVA y ReteICA son impuestos distintos, con
  // certificado distinto y cuenta contable distinta: se guardan aparte para poder sumarlos
  // por separado en SQL. Un único "total retenciones" impide cuadrar cada uno con su
  // certificado. El detalle por concepto sigue en `retencionesFiscales`.
  retenciones     Decimal @default(0) @db.Decimal(18, 2)
  reteIva         Decimal @default(0) @db.Decimal(18, 2)
  reteIca         Decimal @default(0) @db.Decimal(18, 2)
  total           Decimal @db.Decimal(18, 2)
  totalACobrar    Decimal @db.Decimal(18, 2)

  // Desglose de la base por tratamiento de IVA. Denormalizado desde los ítems para poder
  // agregarlo en SQL sin recorrerlos: son los renglones que separa la declaración de IVA.
  // Exento (Art. 477 E.T.) y excluido (Art. 476) NO son lo mismo — el exento da derecho a
  // IVA descontable y a devolución, el excluido no y su IVA se lleva al costo. Meterlos en
  // una sola bolsa de "IVA 0" rompe el prorrateo del Art. 490.
  // La suma de los cuatro debe ser igual a `subtotal`.
  // El desglose POR TARIFA no se guarda aquí a propósito: se obtiene agrupando
  // `FacturaItem.tarifaIva`, y así no hay que migrar columnas cuando cambie una tarifa.
  baseGravada       Decimal @default(0) @db.Decimal(18, 2)
  baseExenta        Decimal @default(0) @db.Decimal(18, 2)
  baseExcluida      Decimal @default(0) @db.Decimal(18, 2)
  baseNoResponsable Decimal @default(0) @db.Decimal(18, 2)
  // Productos con la tarifa heredada "0%", que no es una categoría del régimen. Se aísla
  // en vez de repartirla a ojo: si esta base es > 0, hay productos por clasificar y el
  // pie del historial debe decirlo antes de que alguien use la cifra para declarar.
  baseSinClasificar Decimal @default(0) @db.Decimal(18, 2)

  retencionesFiscales    Json?
  retencionesPorConcepto Json?

  // Snapshot del emisor (config al momento de emitir)
  emisorRazonSocial String?
  emisorNit         String?
  emisorRegimen     String?
  emisorSnapshot    Json?

  // Saldos acumulados por notas aplicadas
  saldoAplicadoNC Decimal @default(0) @db.Decimal(18, 2)
  saldoAplicadoND Decimal @default(0) @db.Decimal(18, 2)

  // Recaudado mediante comprobantes de ingreso. Se materializa (y no solo se deriva) para
  // poder validar el saldo dentro de la transacción y para que el filtro de cartera del
  // historial deje de ser una promesa: hasta ahora el sistema no sabía qué se había cobrado.
  totalRecaudado Decimal @default(0) @db.Decimal(18, 2)

  // Asiento que generó al emitirse. `null` = todavía no está en el libro diario, casi siempre
  // porque al emitir faltaba una cuenta del mapa. Esos documentos se listan como "sin
  // contabilizar" y se pueden contabilizar después; no se pierden ni se ocultan.
  asientoId String?

  items        FacturaItem[]
  notas        Nota[]
  aplicaciones ComprobanteAplicacion[]
  // Borrador del que salió, si nació de uno. Campo virtual: la llave vive en el borrador y
  // aquí no se crea columna. La factura no sabe de borradores para nada más que la traza.
  borrador     BorradorFactura?

  @@unique([usuarioId, numeroCompleto])
  @@index([usuarioId])
  // Los filtros del historial son siempre "de este usuario, en este periodo": todo índice
  // útil arranca por usuarioId y termina en fecha. `fecha` (no `createdAt`) es la fecha
  // fiscal: createdAt es UTC y una factura del 30-abr registrada a las 00:30 Bogotá caería
  // en el bimestre siguiente.
  @@index([usuarioId, fecha])
  @@index([usuarioId, estado, fecha])
  @@index([usuarioId, clienteId, fecha])
  @@index([usuarioId, numero])
  @@map("facturas")
}

// ============================ Tercero (registro de identidad) ============================
//
// QUÉ PROBLEMA RESUELVE. Los proveedores no eran una entidad: vivían como TEXTO SUELTO dentro de
// cada `Compra` y cada `DocumentoSoporte` (`proveedorNombre`, `proveedorNit`). Con eso, el mismo
// proveedor escrito de dos formas eran dos terceros, y no había ningún sitio donde guardar su
// tipo de documento DIAN, su dirección ni sus códigos DANE — que son columnas obligatorias en
// diez de los quince formatos de exógena.
//
// La ley no exige una tabla de terceros; la ARITMÉTICA DEL REPORTE sí. La exógena agrupa el año
// entero por tercero y la DIAN cruza el 1001 del pagador contra el 1007 del receptor: un mismo
// proveedor partido en tres es un cruce que no cuadra, y el art. 651 E.T. sanciona la
// información errónea igual que la que falta.
//
// LOS SNAPSHOTS DE LOS DOCUMENTOS NO SE TOCAN. `Compra.proveedorNombre` y compañía siguen ahí y
// siguen siendo la verdad de ESE documento: un documento fiscal tiene que poder reimprimirse
// como se emitió, aunque el tercero haya cambiado de nombre o de dirección después. El `Tercero`
// es la identidad para AGRUPAR y REPORTAR, no un reemplazo del snapshot.
//
// POR QUÉ `Cliente` NO SE FUSIONÓ AQUÍ (todavía). Un cliente ya es una entidad y ya tiene todos
// estos campos, y fusionarlo obligaría a tocar la emisión de facturas, que es la ruta más
// delicada del sistema. Se deja para después, a propósito: al reportar, un tercero que es
// cliente y proveedor a la vez se consolida por `documento` normalizado, que es trabajo de la
// capa de reportes y no del modelo.
model Tercero {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // SIEMPRE normalizado con `normalizarDocumento()` antes de guardar: es la clave de
  // consolidación y de ella depende que el cruce de la DIAN cuadre. El `@@unique` lo sostiene.
  documento          String
  dv                 String?
  tipoDocumentoDian  String? // código de lib/data/tiposDocumentoDian.js

  // 'natural' | 'juridica'. Decide cuál juego de nombres se exige en el reporte.
  tipo        String  @default("juridica")
  // Nombre para mostrar. Para una persona natural se arma de los cuatro campos; para una
  // jurídica es la razón social.
  nombre      String
  razonSocial String?

  // Los cuatro campos de nombre que exige la DIAN, SEPARADOS. No se deducen partiendo el nombre
  // completo: "María del Carmen Rodríguez Vélez de Ospina" no sale de un `split(' ')`, y un
  // apellido mal partido es información ERRÓNEA, no información faltante.
  primerApellido  String?
  segundoApellido String?
  primerNombre    String?
  otrosNombres    String?

  direccion          String?
  telefono           String?
  email              String?
  codigoDepartamento String? // 2 dígitos DANE
  codigoMunicipio    String? // 3 dígitos DANE
  codigoPais         String? // 3 dígitos DIAN; 169 = Colombia

  activo Boolean @default(true)

  compras  Compra[]
  soportes DocumentoSoporte[]
  clientes Cliente[]

  // Un documento, un tercero, por usuario. Es la red de seguridad de la consolidación.
  @@unique([usuarioId, documento])
  @@index([usuarioId])
  @@map("terceros")
}

// ============================ Borrador de factura ============================
//
// TABLA APARTE, Y NO UN ESTADO MÁS DE `Factura`. La diferencia no es de estilo: hoy media
// aplicación consulta `facturas` dando por hecho que toda fila es un documento fiscal.
// `app/api/contabilizar` recorre `estado != 'anulada'` —un borrador habría acabado en el LIBRO
// DIARIO—, `app/api/resumen` cuenta sin filtrar estado, `comprobantes/pendientes` lo habría
// mostrado como cartera por cobrar y `importExport/registro` lo habría exportado como registro
// fiscal. Con la tabla aparte, ninguno de esos cuatro sitios cambia y el invariante "toda fila
// de `facturas` es un documento fiscal" sigue en pie.
//
// Y CONCEPTUALMENTE UN BORRADOR NO ES UNA FACTURA A MEDIAS: es el INSUMO guardado. La factura
// la calcula el servidor. Por eso aquí no hay `subtotal`, ni `iva`, ni `numero`, ni snapshots:
// guardar aritmética en un borrador es guardar números que envejecen —cambia una tarifa y el
// borrador miente—. Todo se recalcula al emitir, contra las tarifas y la configuración de ese
// momento.
//
// LO QUE UN BORRADOR NO HACE, y es el punto de que exista: no consume consecutivo DIAN. Un
// borrador abandonado que hubiera tomado número dejaría un hueco en la numeración autorizada,
// que es justo lo que prohíbe el art. 617 del E.T.
model BorradorFactura {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // borrador → revisado → emitido. `emitido` es TERMINAL: deja de ser editable y borrable,
  // porque pasa a ser el rastro de origen de un documento fiscal.
  estado String @default("borrador")

  // ---- Insumos: lo que el usuario escribió, nada calculado ----
  clienteId                 String?
  fecha                     String?
  fechaVencimiento          String?
  formaPago                 String?
  medioPago                 String?
  observaciones             String?
  descuentoGlobalPorcentaje Decimal @default(0) @db.Decimal(6, 3)
  reteIvaPorcentaje         Decimal @default(0) @db.Decimal(6, 3)
  reteIcaPorMil             Decimal @default(0) @db.Decimal(8, 4)
  // [{ productoId, cantidad, precioUnitario, descuentoPorcentaje }]. El precio SÍ se guarda:
  // `calcularFactura` lo honra y el del catálogo es solo el valor por defecto. Vacío = usar el
  // del catálogo al emitir. En JSON y no en tabla
  // hija a propósito: `FacturaItem` guarda columnas CALCULADAS (base, valorIva, subtotal,
  // tipoIva) que en un borrador serían aritmética caducada. Además el borrador se reescribe
  // entero en cada guardado, y una tabla hija obligaría a borrar y recrear filas cada vez.
  items                     Json
  instrumentos              Json?

  // ---- Revisión ----
  // Huella COMPLETA de la liquidación aprobada (ver `COMPONENTES_HUELLA` en
  // `lib/emitirFactura.js`): subtotal, cada base por tratamiento de IVA, IVA, INC, cada
  // retención y los totales. NO es autoritativa para nada fiscal; existe solo para detectar si
  // algo cambió entre la revisión y la emisión.
  //
  // Es la huella entera y no un total porque comparar una sola cifra deja pasar cambios que se
  // compensan: pasar un producto de gravado a excluido subiéndole el precio da el mismo total a
  // cobrar y mueve todo el IVA generado del periodo. Al emitir se comparan campo a campo con
  // igualdad exacta; si algo difiere, el borrador vuelve a `borrador` en vez de emitir cifras
  // que nadie aprobó.
  huellaRevisada Json?
  // El total aprobado, aparte y en columna propia: es lo único que necesita la LISTA de
  // borradores, y sacarlo del JSON en cada fila para pintarlo sería trabajo de más.
  totalRevisado Decimal? @db.Decimal(18, 2)
  revisadoEn    String? // YYYY-MM-DD, hora Bogotá
  // Quién revisó. Hoy es SIEMPRE el dueño de la cuenta: no hay modelo multiusuario, así que
  // esto es autocontrol y no segregación de funciones. Se deja escrito para no tener que
  // rehacer la tabla el día que haya miembros y roles de verdad.
  revisadoPorId String?

  // ---- Emisión ----
  // La factura que salió de este borrador. `Restrict` porque los documentos fiscales no se
  // borran; el `@unique` es la red de seguridad contra la doble emisión —dos clics no pueden
  // costar dos consecutivos DIAN.
  factura   Factura? @relation(fields: [facturaId], references: [id], onDelete: Restrict)
  facturaId String?  @unique
  emitidoEn String?

  @@index([usuarioId, estado, updatedAt])
  @@map("borradores_factura")
}

// ============================ Notas débito / crédito (DIAN Anexo 1.9) ============================
model Nota {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  numero String // NC-0001 | ND-0001
  tipo   String // 'credito' | 'debito'
  fecha  String

  motivoCodigo String
  motivoLabel  String

  // Factura relacionada (opcional) + snapshot de referencia
  factura    Factura? @relation(fields: [facturaId], references: [id])
  facturaId  String?
  facturaRef String?

  // Snapshot del cliente (tomado de la factura)
  clienteNombre    String?
  clienteDocumento String?

  subtotal        Decimal @db.Decimal(18, 2)
  totalDescuentos Decimal @default(0) @db.Decimal(18, 2)
  totalIva        Decimal @default(0) @db.Decimal(18, 2)
  totalNota       Decimal @db.Decimal(18, 2)
  observaciones   String?

  // Asiento que generó al emitirse. `null` = todavía no está en el libro diario, casi siempre
  // porque al emitir faltaba una cuenta del mapa. Esos documentos se listan como "sin
  // contabilizar" y se pueden contabilizar después; no se pierden ni se ocultan.
  asientoId String?

  items NotaItem[]

  @@unique([usuarioId, numero])
  @@index([usuarioId])
  @@index([facturaId])
  @@map("notas")
}

model NotaItem {
  id     String @id @default(cuid())
  nota   Nota   @relation(fields: [notaId], references: [id], onDelete: Cascade)
  notaId String

  descripcion    String
  cantidad       Decimal @db.Decimal(18, 3)
  precioUnitario Decimal @db.Decimal(18, 2)
  descuento      Decimal @default(0) @db.Decimal(6, 3) // porcentaje
  iva            Decimal @default(0) @db.Decimal(6, 3) // porcentaje
  base           Decimal @db.Decimal(18, 2)
  subtotalItem   Decimal @db.Decimal(18, 2)

  @@index([notaId])
  @@map("nota_items")
}

// ============================ Nómina ============================
model Empleado {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nombres        String
  apellidos      String
  documento      String
  cargo          String
  tipoContrato   String?
  salarioBase    Decimal @db.Decimal(18, 2)
  // ---- Identificación para el formato 2276 (rentas de trabajo) ----
  // El 2276 pide tipo de documento en código DIAN, los cuatro campos de nombre separados,
  // dirección y ubicación con códigos DANE. Nada de eso se guardaba. Nullable: no puede impedir
  // dar de alta a un empleado hoy; lo que falte sale en el tablero de preparación.
  tipoDocumentoDian  String?
  primerApellido     String?
  segundoApellido    String?
  primerNombre       String?
  otrosNombres       String?
  direccion          String?
  codigoDepartamento String?
  codigoMunicipio    String?
  codigoPais         String?

  eps            String?
  afp            String?
  arl            String?
  // Clase de riesgo I..V. La tarifa de la ARL la determina la actividad del cargo, no el
  // salario, y va del 0,522% al 6,96%: asumir la clase I subestima el costo laboral hasta en
  // un 6,4% del salario en los trabajos de alto riesgo.
  claseRiesgoArl String  @default("I")
  activo         Boolean @default(true)

  nominas Nomina[]

  @@index([usuarioId])
  @@map("empleados")
}

model Nomina {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  createdAt DateTime @default(now())

  empleado   Empleado? @relation(fields: [empleadoId], references: [id], onDelete: SetNull)
  empleadoId String?

  fechaLiquidacion DateTime @default(now())

  // Periodo liquidado, "AAAA-MM". Es lo que identifica la nómina, no la fecha en que se digitó:
  // sin él se podía liquidar dos veces el mismo mes —duplicando el gasto y el pasivo de
  // seguridad social— y una nómina de diciembre digitada en enero se liquidaba con los
  // parámetros del año nuevo. El `@@unique` de abajo lo sostiene desde la base.
  periodo String

  // Snapshot del empleado
  empleadoNombre    String
  empleadoDocumento String?
  empleadoCargo     String?
  salarioBase       Decimal @db.Decimal(18, 2)

  // Conceptos
  diasTrabajados      Int     @default(30)
  salarioProporcional Decimal @db.Decimal(18, 2)
  transporte          Decimal @default(0) @db.Decimal(18, 2)
  // Horas extra y recargos van SEPARADOS: ambos son salario y cotizan, pero el trabajo
  // suplementario NO entra en la base de vacaciones (art. 192 num. 2 CST) y los recargos sí.
  extras              Decimal @default(0) @db.Decimal(18, 2)
  recargos            Decimal @default(0) @db.Decimal(18, 2)
  comisiones          Decimal @default(0) @db.Decimal(18, 2)
  salud               Decimal @default(0) @db.Decimal(18, 2)
  pension             Decimal @default(0) @db.Decimal(18, 2)
  prestamos           Decimal @default(0) @db.Decimal(18, 2)
  otrasDeducciones    Decimal @default(0) @db.Decimal(18, 2)

  // Fondo de solidaridad pensional: 1% adicional a cargo del TRABAJADOR desde 4 SMLMV
  // (art. 27 Ley 100/1993).
  fsp Decimal @default(0) @db.Decimal(18, 2)

  // Aportes del EMPLEADOR. No se le descuentan al trabajador: son costo adicional. Sin ellos
  // el gasto de nómina quedaba subestimado en torno al 38% del salario.
  saludPatronal    Decimal @default(0) @db.Decimal(18, 2)
  pensionPatronal  Decimal @default(0) @db.Decimal(18, 2)
  arl              Decimal @default(0) @db.Decimal(18, 2)
  sena             Decimal @default(0) @db.Decimal(18, 2)
  icbf             Decimal @default(0) @db.Decimal(18, 2)
  cajaCompensacion Decimal @default(0) @db.Decimal(18, 2)
  // Si se aplicó la exoneración del art. 114-1 E.T. Se guarda el HECHO, no solo su efecto:
  // dentro de dos años hay que poder explicar por qué esa nómina no llevó salud patronal.
  exonerado        Boolean @default(false)

  // Prestaciones sociales. Son PROVISIÓN mensual: se causan aunque se paguen después.
  cesantias          Decimal @default(0) @db.Decimal(18, 2)
  interesesCesantias Decimal @default(0) @db.Decimal(18, 2)
  prima              Decimal @default(0) @db.Decimal(18, 2)
  vacaciones         Decimal @default(0) @db.Decimal(18, 2)

  // Totales
  totalDevengos          Decimal @db.Decimal(18, 2)
  totalDeducciones       Decimal @db.Decimal(18, 2)
  totalAportesPatronales Decimal @default(0) @db.Decimal(18, 2)
  totalPrestaciones      Decimal @default(0) @db.Decimal(18, 2)
  // Lo que de verdad cuesta el trabajador: devengos + aportes patronales + prestaciones.
  costoTotal             Decimal @default(0) @db.Decimal(18, 2)
  neto                   Decimal @db.Decimal(18, 2)

  // Asiento que generó al emitirse. `null` = todavía no está en el libro diario, casi siempre
  // porque al emitir faltaba una cuenta del mapa. Esos documentos se listan como "sin
  // contabilizar" y se pueden contabilizar después; no se pierden ni se ocultan.
  asientoId String?

  estado String @default("Pendiente") // Pendiente | Pagada | Anulada

  // La unicidad de empleado + periodo es PARCIAL: solo entre las nóminas VIVAS. Prisma no
  // expresa índices parciales, así que vive como SQL crudo en la migración
  // `20260815140000_nomina_unicidad_parcial`. Antes era un @@unique total, y para poder rehacer
  // una nómina anulada había que RENOMBRARLE el periodo: se mutaba el campo que identifica un
  // documento fiscal ya emitido, justo lo que este repo no hace en ningún otro módulo.
  @@index([usuarioId])
  @@index([empleadoId])
  @@index([empleadoId, periodo])
  @@map("nominas")
}

// ============================ Compras (facturas de proveedor) ============================
model Compra {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  numFactura       String
  fecha            String
  fechaVencimiento String?
  tipoDoc          String?
  condicionPago    String?
  medioPago        String?

  // Proveedor.
  // El tipo de documento importa: el certificado de retención lo imprime, y dar por hecho
  // "NIT" convertía a una persona natural con cédula en una sociedad.
  // Snapshot del proveedor EN ESE DOCUMENTO. No se toca ni se deriva del `Tercero`: la compra
  // tiene que poder reimprimirse como se registró, aunque el tercero cambie después.
  proveedorNombre        String
  proveedorNit           String?
  proveedorTipoDocumento String?
  proveedorTel           String?

  // Identidad consolidada, para agrupar y reportar. Nullable porque un documento anterior al
  // registro de terceros —o uno sin NIT— no tiene con qué enlazarse, y eso se ve como pendiente
  // en el tablero de exógena en vez de bloquear el registro de la compra.
  tercero   Tercero? @relation(fields: [terceroId], references: [id], onDelete: SetNull)
  terceroId String?

  // Totales
  subtotal         Decimal @db.Decimal(18, 2)
  totalDescuentos  Decimal @default(0) @db.Decimal(18, 2)
  totalIva         Decimal @default(0) @db.Decimal(18, 2)
  totalRetenciones Decimal @default(0) @db.Decimal(18, 2)
  totalBruto       Decimal @db.Decimal(18, 2)
  totalAPagar      Decimal @db.Decimal(18, 2)

  // Retenciones manuales: { retefuente:{activa,tarifa,unidad,base,valor}, reteiva, reteica }
  retenciones   Json?
  observaciones String?

  // Pagado mediante comprobantes de egreso. Ver la nota de `Factura.totalRecaudado`.
  totalPagado Decimal @default(0) @db.Decimal(18, 2)

  // Asiento que generó al emitirse. `null` = todavía no está en el libro diario, casi siempre
  // porque al emitir faltaba una cuenta del mapa. Esos documentos se listan como "sin
  // contabilizar" y se pueden contabilizar después; no se pierden ni se ocultan.
  asientoId String?

  items                  CompraItem[]
  aplicaciones           ComprobanteAplicacion[]
  retencionesPracticadas RetencionPracticada[]

  @@index([usuarioId])
  @@map("compras")
}

model CompraItem {
  id       String @id @default(cuid())
  compra   Compra @relation(fields: [compraId], references: [id], onDelete: Cascade)
  compraId String

  descripcion    String
  cantidad       Decimal @db.Decimal(18, 3)
  precioUnitario Decimal @db.Decimal(18, 2)
  descuento      Decimal @default(0) @db.Decimal(6, 3) // porcentaje
  iva            Decimal @default(0) @db.Decimal(6, 3) // porcentaje
  base           Decimal @db.Decimal(18, 2)
  subtotalItem   Decimal @db.Decimal(18, 2)

  // ¿Es un ACTIVO FIJO? Tiene dos consecuencias fiscales y ninguna es menor:
  //   · El IVA en la adquisición de activos fijos NO es descontable (art. 491 E.T.): va al costo
  //     del activo, o al descuento del art. 258-1 en renta. Reportarlo como descontable en el
  //     formato 1005 es declarar un descontable que no existe.
  //   · En el formato 1001, la compra de activos MOVIBLES va al concepto 5007 y la de activos
  //     FIJOS al 5008 (art. 60 E.T.). Sin este campo no hay forma de separarlos, y meterlos en
  //     el mismo concepto descuadra el cruce contra la depreciación.
  //
  // Por defecto `false`: lo normal es comprar inventario y gasto corriente, y marcar activo fijo
  // es la excepción que el usuario declara.
  esActivoFijo Boolean @default(false)

  @@index([compraId])
  @@map("compra_items")
}

// ============================ Retenciones practicadas ============================
// Tabla ÚNICA de las retenciones que NOSOTROS practicamos a terceros.
//
// Antes vivían en tres sitios que no se podían cruzar: `Compra.retenciones` (un Json, y sin
// concepto), las columnas sueltas de `DocumentoSoporte` (sin concepto ni municipio) y
// `ComprobanteRetencion`. Con eso era imposible responder "¿cuánto le retuve a este tercero
// en 2025 por servicios?", que es exactamente lo que pide el certificado del Art. 381 E.T.
//
// El certificado NO es un dato que se captura: es una consulta acumulada por tercero,
// concepto y año sobre esta tabla.
//
// OJO con el doble conteo: la retención se practica en el pago o abono en cuenta, lo que
// ocurra primero — normalmente en la CAUSACIÓN. Cuando la política del usuario dice que se
// causan, la fila del comprobante de pago es informativa y NO debe sumar al certificado. Eso
// lo marca `vinculante`.
model RetencionPracticada {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  createdAt DateTime @default(now())

  // Documento que la originó. Exactamente uno de los tres.
  origen             String // 'compra' | 'documento_soporte' | 'comprobante'
  compra             Compra?               @relation(fields: [compraId], references: [id], onDelete: Cascade)
  compraId           String?
  documentoSoporte   DocumentoSoporte?     @relation(fields: [documentoSoporteId], references: [id], onDelete: Cascade)
  documentoSoporteId String?
  comprobante        ComprobanteTesoreria? @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  comprobanteId      String?

  docRef String // "FP-450", "DS-2026-0001", "CE-2026-00003"
  fecha  String // fecha del documento origen, en hora Bogotá
  anio   Int // se materializa para agrupar el certificado sin parsear texto

  // Tercero al que se le practicó. El certificado y la exógena lo identifican por DOCUMENTO,
  // no por nombre: el mismo tercero se escribe de diez formas distintas.
  //
  // `terceroNumeroDocumento` va NORMALIZADO (sin puntos, guiones ni DV). Sin eso "900.123.456",
  // "900123456" y "900123456-7" son tres terceros distintos y el mismo proveedor recibe tres
  // certificados parciales — que para el Art. 667 cuenta igual que no expedirlos.
  terceroNombre          String
  terceroTipoDocumento   String? // 'NIT' | 'CC' | 'CE' | 'PA' | 'TI'
  terceroNumeroDocumento String?
  terceroDv              String?

  tipo           String // 'retefuente' | 'reteiva' | 'reteica'
  conceptoCodigo String? // id de lib/data/tablaRetefuente.js, para agrupar sin ambigüedad
  conceptoNombre String?
  base           Decimal  @db.Decimal(18, 2)
  // Valor de la operación gravada SIN IVA. Solo lo usa la ReteIVA, cuya `base` es el IVA y no
  // el valor de la operación: el art. 1.6.1.12.13 del Decreto 1625 exige los dos por separado
  // en el certificado, y con una sola columna el documento sale incompleto.
  baseOperacion  Decimal? @db.Decimal(18, 2)
  tarifa         Decimal  @db.Decimal(8, 4)
  unidad         String   @default("%") // '%' o '‰' (el ICA va por mil)
  valor          Decimal  @db.Decimal(18, 2)
  // El ICA se declara en el municipio donde se practicó: mezclarlos liquida mal esa declaración.
  municipio      String?

  // false = registro informativo que no debe sumar al certificado (ver nota de arriba).
  vinculante Boolean @default(true)

  @@index([usuarioId, anio, tipo])
  @@index([usuarioId, terceroNumeroDocumento, anio])
  @@index([comprobanteId])
  @@index([compraId])
  @@index([documentoSoporteId])
  @@map("retenciones_practicadas")
}

// ============================ Certificados de retención ============================
// El certificado NO es un dato que se captura: es una consulta acumulada por tercero, año y
// concepto sobre `RetencionPracticada`. Lo que se persiste aquí es la EXPEDICIÓN.
//
// Por qué persistirla: si en 2027 se reexpide el certificado de 2025 y entretanto se corrigió
// un comprobante, la consulta daría cifras distintas a las que el tercero ya recibió y usó en
// su declaración. El snapshot conserva lo que efectivamente se certificó.
//
// Obligación y plazos: el de renta (Art. 381 E.T.) y el de rentas de trabajo (Art. 378) son
// ANUALES; el de ReteIVA es por periodo. No expedirlos tiene sanción (Art. 667 E.T.).
// El Art. 381 obliga además a expedir uno por operación cuando el beneficiario lo solicita.
model CertificadoRetencion {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  createdAt DateTime @default(now())

  numero String
  tipo   String // 'retefuente' | 'reteiva' | 'reteica'
  anio   Int

  // ReteIVA se certifica POR PERIODO GRAVABLE (art. 600 E.T.), no por año, y ReteICA POR
  // MUNICIPIO: cada retención se descuenta en la declaración de su municipio, así que sumarlos
  // da una cifra que no sirve para ninguna.
  //
  // `periodo` es la clave del periodo ('2026-B4'), no texto libre: antes se podía rotular
  // "Bimestre 4" sobre las cifras del año completo. `periodoDesde/Hasta` es el rango con el que
  // realmente se filtraron las líneas.
  periodo      String?
  periodoDesde String? // 'AAAA-MM-DD', inclusive
  periodoHasta String? // 'AAAA-MM-DD', inclusive
  municipio    String?

  terceroNombre          String
  terceroTipoDocumento   String?
  terceroNumeroDocumento String
  terceroDv              String?

  totalBase      Decimal  @db.Decimal(18, 2)
  totalValor     Decimal  @db.Decimal(18, 2)
  // Suma de las operaciones gravadas sin IVA. Solo aplica a ReteIVA (art. 1.6.1.12.13 Dcto 1625).
  totalOperacion Decimal? @db.Decimal(18, 2)

  // Snapshot de los conceptos y del emisor tal como se certificaron.
  detalle        Json
  emisorSnapshot Json

  // El Art. 381 pide "ciudad donde se consignó la retención" — no es la del documento, es
  // donde el agente declaró y pagó.
  ciudadConsignacion String?

  expedidoPor String?
  expedidoEn  DateTime @default(now())

  // Anulación con rastro. Sin quién, cuándo y por qué, "no se borra, se anula" es solo una
  // palabra: el que recibe el reemplazo necesita saber cuál certificado rige.
  anulado         Boolean   @default(false)
  anuladoPor      String?
  anuladoEn       DateTime?
  motivoAnulacion String?
  // Certificado que reemplaza a este (o al que este reemplaza).
  reemplazaAId    String?

  @@unique([usuarioId, numero])
  @@index([usuarioId, anio, terceroNumeroDocumento])
  @@map("certificados_retencion")
}

// ============================ Comprobantes de tesorería ============================
// Comprobante de ingreso (recibo de caja) y de egreso (comprobante de pago).
//
// Naturaleza legal: son comprobantes de contabilidad, no documentos de facturación
// electrónica. No requieren resolución DIAN, ni prefijo autorizado, ni CUFE, ni se
// transmiten. Pero SÍ son exigencia normativa: el Código de Comercio (art. 53) manda que los
// asientos se hagan con base en comprobantes, y el Decreto 2649 de 1993 (arts. 123 y 124,
// vigentes por remisión del Decreto 2420 de 2015) exige que estén numerados consecutivamente,
// en español, con el día de preparación y las personas que los elaboraron y autorizaron, y en
// correspondencia con los libros.
//
// Conservación: 10 años (C.Co. art. 60, modificado por la Ley 962 de 2005). La ley admite
// medio electrónico si garantiza reproducción exacta, así que no hace falta papel firmado —
// pero tampoco se pueden borrar.
//
// OJO: el comprobante de egreso prueba que se pagó, NO vuelve deducible el gasto. El soporte
// fiscal de la deducción sigue siendo la factura electrónica o el documento soporte
// (art. 771-2 E.T.).
model ComprobanteTesoreria {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tipo String // 'ingreso' | 'egreso'

  // Numeración consecutiva e independiente por tipo y año. Se asigna al EMITIR, no al crear
  // el borrador: así un borrador descartado no deja un hueco en la serie.
  // Prefijo CI/CE (no NC-, que ya lo usa la nota crédito y colisionaría).
  prefijo     String?
  consecutivo Int?
  anio        Int?
  numero      String? // "CI-2026-00001"

  fecha  String // fecha real del movimiento, no la de generación
  ciudad String?

  // Tercero
  terceroNombre    String
  terceroDocumento String?
  // Dirección del tercero. La usa la información exógena. OJO: la dirección que exigen el
  // certificado de retención (Art. 381 lit. c E.T.) y el de rentas de trabajo (Art. 379) es
  // la del AGENTE RETENEDOR, no la del retenido — esa viaja en `emisorSnapshot`.
  terceroDireccion String?

  // Medio de pago y trazabilidad bancaria
  medioPago             String?
  cuentaTesoreria       CuentaTesoreria? @relation(fields: [cuentaTesoreriaId], references: [id], onDelete: SetNull)
  cuentaTesoreriaId     String?
  cuentaTesoreriaPuc    String? // snapshot: el comprobante debe seguir mostrando de dónde salió
  cuentaTesoreriaNombre String?
  bancoRef              String?
  numTransaccion        String? // número de transacción, cheque o consignación
  chequeBanco           String?
  chequeFecha           String?

  // MODO del comprobante:
  //   'aplicacion' → cancela el saldo de un documento previo (factura o compra). La
  //                  contrapartida la pone el sistema; el usuario no la elige.
  //   'imputacion' → no hay documento previo (nómina, impuestos, anticipos, caja menor). El
  //                  usuario elige un CONCEPTO de una lista cerrada y el concepto trae su
  //                  cuenta del mapa. Nunca se teclea un código PUC: eso sería un asiento
  //                  manual disfrazado, y el asiento manual se cerró a propósito.
  modo String @default("aplicacion")

  concepto      String  @db.Text
  observaciones String?

  // Snapshot del emisor al contabilizar, igual que en Factura. Un comprobante de 2026 debe
  // seguir mostrando la razón social de 2026 aunque la empresa cambie de nombre — y un
  // egreso que soporta una retención tiene que identificar al agente retenedor.
  emisorRazonSocial String?
  emisorNit         String?
  emisorSnapshot    Json?

  // Liquidación. El valor en letras y el "recibí" del beneficiario son sobre el NETO, no
  // sobre el bruto: es lo que efectivamente se entregó o se recibió.
  valorBruto       Decimal @db.Decimal(18, 2)
  totalRetenciones Decimal @default(0) @db.Decimal(18, 2)
  otrosDescuentos  Decimal @default(0) @db.Decimal(18, 2)
  neto             Decimal @db.Decimal(18, 2)

  // Ciclo de vida:
  //   borrador  → aún no afectó libros; se puede editar o descartar sin dejar hueco.
  //   emitido   → tiene consecutivo y asiento; ya no se edita.
  //   anulado   → se anuló ANTES de afectar libros; conserva el número, que nunca se reutiliza.
  //   reversado → ya había afectado libros: se corrige con un comprobante que invierte los
  //               movimientos, no editando el original.
  estado          String  @default("borrador")
  motivoAnulacion String?
  // Quién y cuándo anuló. `Factura.fechaAnulacion` existe por la misma razón: sin fecha, un
  // periodo ya declarado deja de ser reproducible.
  anuladoPor      String?
  fechaAnulacion  String?

  // Asiento generado al contabilizar. Guardarlo evita el doble registro: si ya existe, el
  // comprobante no vuelve a contabilizar.
  asientoId String?

  // Reversión
  reversaAId  String? // comprobante que este reversa
  reversadoEn String?

  // Art. 124 D. 2649 pide "las personas que lo elaboraron y autorizaron". Pide indicación de
  // las personas, NO rúbrica manuscrita: el usuario autenticado con fecha y hora cumple mejor
  // que una raya en blanco.
  elaboradoPor  String?
  elaboradoEn   DateTime?
  autorizadoPor String?
  autorizadoEn  DateTime?

  aplicaciones           ComprobanteAplicacion[]
  imputaciones           ComprobanteImputacion[]
  retenciones            ComprobanteRetencion[]
  retencionesPracticadas RetencionPracticada[]

  @@unique([usuarioId, tipo, anio, consecutivo])
  @@index([usuarioId, tipo, fecha])
  @@index([usuarioId, estado])
  @@map("comprobantes_tesoreria")
}

// A qué documentos se aplica el dinero. Sin esto nada impide emitir dos recibos del 50% y
// luego otro del 100% sobre la misma factura: la cartera nunca cerraría y el comprobante
// impreso contradiría los libros.
model ComprobanteAplicacion {
  id            String               @id @default(cuid())
  comprobante   ComprobanteTesoreria @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  comprobanteId String

  factura            Factura?          @relation(fields: [facturaId], references: [id])
  facturaId          String?
  compra             Compra?           @relation(fields: [compraId], references: [id])
  compraId           String?
  // El documento soporte también crea un pasivo con el proveedor. Sin esta aplicación, ese
  // saldo crecía y NINGÚN módulo podía cancelarlo: el egreso solo se aplicaba a compras.
  documentoSoporte   DocumentoSoporte? @relation("PagosDeSoporte", fields: [documentoSoporteId], references: [id])
  documentoSoporteId String?

  docRef         String // "FE-00001", para que el impreso lo muestre aunque se borre el vínculo
  valorDocumento Decimal @db.Decimal(18, 2)
  saldoAnterior  Decimal @db.Decimal(18, 2)
  valorAplicado  Decimal @db.Decimal(18, 2)
  saldoNuevo     Decimal @db.Decimal(18, 2)

  @@index([comprobanteId])
  @@index([facturaId])
  @@index([compraId])
  @@index([documentoSoporteId])
  @@map("comprobante_aplicaciones")
}

// Retenciones del comprobante, con concepto, base y tarifa. No es adorno: es la información
// con la que después se expide el certificado de retención al proveedor y se llenan las
// declaraciones mensuales.
// Líneas del comprobante en modo imputación. Tabla propia y no un JSON: se consulta, se
// audita y se puede agregar por concepto para conciliar contra los saldos que cancela.
model ComprobanteImputacion {
  id            String               @id @default(cuid())
  comprobante   ComprobanteTesoreria @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  comprobanteId String

  concepto            String // clave de lib/conceptosComprobante.js
  etiqueta            String // texto del concepto al momento de emitir
  // Cuenta resuelta desde el mapa AL EMITIR. Se congela: si el usuario cambia su mapa después,
  // el comprobante debe seguir diciendo contra qué cuenta se registró.
  cuentaPuc           String
  valor               Decimal @db.Decimal(18, 2)
  detalle             String?
  // Referencia del documento que soporta el gasto (Art. 771-2 E.T.). Obligatoria cuando el
  // concepto es de naturaleza costo o gasto.
  documentoSoporteRef String?

  @@index([comprobanteId])
  @@map("comprobante_imputaciones")
}

model ComprobanteRetencion {
  id            String               @id @default(cuid())
  comprobante   ComprobanteTesoreria @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  comprobanteId String

  tipo      String // 'retefuente' | 'reteiva' | 'reteica'
  concepto  String?
  base      Decimal @db.Decimal(18, 2)
  tarifa    Decimal @db.Decimal(8, 4)
  unidad    String  @default("%") // '%' o '‰' (el ICA va por mil)
  valor     Decimal @db.Decimal(18, 2)
  // El ICA se descuenta en la declaración del municipio donde se practicó: mezclarlos en una
  // sola cuenta liquida mal esa declaración.
  municipio String?

  @@index([comprobanteId])
  @@map("comprobante_retenciones")
}

// Consecutivos por usuario, tipo y año. `count(*)` NO es un consecutivo: si se borra o filtra
// algo, se repiten números, y el @@unique lo convierte en un 409 en producción en vez de en
// un número correcto. Se lee e incrementa con UPDATE dentro de la transacción.
model ConsecutivoDocumento {
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  tipo      String // 'ingreso' | 'egreso' | 'nota_contabilidad'
  anio      Int
  actual    Int     @default(0)

  @@id([usuarioId, tipo, anio])
  @@map("consecutivos_documento")
}

// ============================ Mapa de cuentas contables ============================
// Qué cuenta del PUC usa cada usuario para cada concepto. Sin esto, el generador de
// comprobantes tendría que traer códigos cableados, y el catálogo cargado es un modelo de
// referencia con auxiliares de ejemplo ("Zona Norte", "Proveedor Insumos SAS"): ninguna
// empresa real tiene exactamente esos.
//
// El sistema PROPONE desde el catálogo y el usuario CONFIRMA. La cuenta concreta es una
// decisión contable, no algo que el software deba adivinar.
model MapaCuentas {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Catálogo contra el que se validan estas cuentas.
  sector String @default("comercial") // 'comercial' | 'esal'

  // Cartera y proveedores
  clientes         String?
  proveedores      String?
  anticipoClientes String?

  // ---- Cuentas de resultado, para que las OPERACIONES lleguen al libro ----
  // Hasta ahora solo los comprobantes de tesorería y las notas de contabilidad generaban
  // asiento: las ventas, las compras, las notas D/C, los documentos soporte y la nómina no
  // entraban al libro diario por ninguna vía. Sin estas cuentas no hay contra qué imputarlas.
  //
  // Una sola cuenta por concepto, no una por producto: el desglose fino es una decisión que
  // cada empresa toma distinto, y proponer un default razonable vale más que exigir un mapeo
  // exhaustivo antes de poder facturar.
  ingresosVentas     String? // 4135 o la que use el usuario
  devolucionesVentas String? // 4175 — la nota crédito no se registra como ingreso negativo
  comprasInventario  String? // 1435 (inventario) o 6205 (compras), según el método
  gastosGenerales    String? // 5195 — contrapartida del documento soporte

  // Nómina. La salud y la pensión DESCONTADAS al trabajador son un pasivo con la EPS y el
  // fondo, no un gasto: el gasto es el devengo completo.
  gastoNomina            String? // 5105
  salariosPorPagar       String? // 2505
  saludPorPagar          String? // 237005
  pensionPorPagar        String? // 237006
  prestamosEmpleados     String? // 1365 — el descuento abona la cuenta por cobrar
  otrasDeduccionesNomina String? // 2380 u otras por pagar

  // Aportes del empleador y prestaciones sociales. El GASTO va separado por concepto porque
  // así lo pide el estado de resultados y porque cada uno tiene su propia base de cálculo.
  // Una cuenta por componente. Antes eran dos cuentas agregadas, y cualquier código del PUC que
  // se eligiera llevaba el nombre de UNO de los componentes: la ARL terminaba sumada bajo
  // "Aportes a EPS". El pasivo ya iba desagregado; el gasto también debe estarlo.
  gastoAuxilioTransporte     String? // 510515 — no es salario, no se mezcla con el sueldo
  gastoSaludPatronal         String? // 510527
  gastoPensionPatronal       String? // 510528
  gastoArl                   String? // 510529
  gastoParafiscales          String? // 510531 — SENA, ICBF y caja
  gastoCesantias             String? // 510530
  gastoInteresesCesantias    String? // 510533
  gastoPrima                 String? // 510536
  gastoVacaciones            String? // 510539
  arlPorPagar                String? // 237010
  parafiscalesPorPagar       String? // 237015 — SENA, ICBF y caja de compensación
  cesantiasPorPagar          String? // 250510
  interesesCesantiasPorPagar String? // 250515
  primaPorPagar              String? // 250520
  vacacionesPorPagar         String? // 250525

  // Retenciones que NOS practican: son un ACTIVO (anticipo de impuesto a favor).
  reteFuenteFavor String?
  reteIvaFavor    String?
  reteIcaFavor    String?

  // Retenciones que NOSOTROS practicamos: son un PASIVO (se le deben a la DIAN o al
  // municipio). Confundir los dos sentidos es el error más común del módulo.
  reteFuentePorPagar String?
  reteIvaPorPagar    String?
  reteIcaPorPagar    String?

  // Impuestos
  ivaGenerado    String?
  ivaDescontable String?
  incPorPagar    String?

  // Entradas de dinero que NO son ingreso: un préstamo crea una obligación y un aporte va al
  // patrimonio. Registrarlos como ingreso infla el resultado y la base del IVA.
  obligacionesFinancieras String?
  aportesSociales         String?

  // Pagos que salieron antes de tener el documento que los soporta. Es un ACTIVO (1330):
  // entregamos plata y todavía no tenemos el bien, el servicio ni el documento. Llevarlos a
  // proveedores dejaría esa cuenta con saldo débito —un activo disfrazado de pasivo— entre el
  // pago y su legalización, y el gasto sin reconocer en ese intervalo.
  anticiposPorLegalizar String?

  // Otros conceptos que aparecen al pagar o recaudar
  gmf                 String? // gravamen a los movimientos financieros
  descuentoProntoPago String?
  ajusteAlPeso        String?

  // Política contable: ¿las retenciones se registran al causar el documento (lo estándar) o
  // al pagarlo? De esto depende si el comprobante debe volver a moverlas. Si se registran en
  // la causación y el comprobante las repite, se duplica el activo por retenciones.
  retencionesEnCausacion Boolean @default(true)

  @@map("mapa_cuentas")
}

// Cajas y cuentas bancarias del usuario. El comprobante propone una según el medio de pago,
// pero cuál banco concreto sale del dinero lo decide siempre el usuario.
model CuentaTesoreria {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  createdAt DateTime @default(now())

  nombre    String // "Bancolombia — Cta. Corriente 123"
  cuentaPuc String // código del catálogo
  tipo      String @default("banco") // 'caja' | 'banco'

  // Medio de pago que la sugiere por defecto (códigos de lib/data/mediosPago.js).
  medioPago String?

  // Si la cuenta está gravada con el 4x1000, el egreso debe proponer el GMF.
  gravadaGmf     Boolean @default(true)
  predeterminada Boolean @default(false)
  activa         Boolean @default(true)

  comprobantes ComprobanteTesoreria[]

  @@index([usuarioId])
  @@map("cuentas_tesoreria")
}

// ============================ Catálogo de impuestos ============================
// Las tarifas las fija la ley, no el usuario: por eso el catálogo es un dato de referencia
// (como CuentaPUC) y no una lista en código. Tenerla en código obligaba a un despliegue por
// cada cambio normativo, y en 2025-2026 hubo varios.
//
// La forma imita la del UBL 2.1 que exige la DIAN (TaxTotal → TaxSubtotal → TaxCategory /
// TaxScheme). Así, generar el XML para el proveedor tecnológico es serializar filas en vez
// de reconstruir el modelo. Hacerlo después de emitir facturas electrónicas significaría
// migrar documentos fiscales ya declarados, que no se pueden tocar.
model Impuesto {
  id String @id @default(cuid())

  // null = catálogo del sistema (normativo, compartido). Con valor = impuesto propio del
  // usuario, para casos que la norma general no cubre.
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String?
  esSistema Boolean  @default(false)

  codigo String // clave estable: 'IVA_19', 'INC_8'
  nombre String // "IVA 19% general"

  // El TIPO es lo que faltaba: sin él, IVA e Impuesto al Consumo caían en el mismo campo y
  // el INC terminaba declarado como IVA. Son formularios distintos y el INC no es descontable.
  tipo String // 'IVA' | 'INC' | 'IC' | 'ICA' | 'BOLSAS' | 'OTRO'

  // Códigos del anexo técnico (tabla 13.2.2). Un código que no esté en esa tabla hace que la
  // DIAN RECHACE el documento (regla FAX16) — a diferencia de una tarifa fuera de tabla, que
  // solo genera notificación y deja pasar la factura mal liquidada.
  codigoDian String
  nombreDian String

  // Porcentual o nominal por unidad: las bolsas plásticas y el IBUA no son un porcentaje,
  // y no caben en un campo de tarifa.
  esNominal     Boolean  @default(false)
  tarifa        Decimal? @db.Decimal(6, 3)
  valorUnitario Decimal? @db.Decimal(18, 2)
  unidadMedida  String?

  // Vigencia. Sin ella se podía emitir HOY una factura con una tarifa derogada: el selector
  // ofrecía el 35% sin reparar en la fecha del documento.
  vigenteDesde String // YYYY-MM-DD
  vigenteHasta String? // null = vigente

  // Por qué existe esta tarifa, cuando no es obvio (regímenes de transición, etc.).
  notas  String?
  activo Boolean @default(true)

  productos ProductoImpuesto[]

  @@unique([usuarioId, codigo])
  @@index([tipo])
  @@index([vigenteDesde])
  @@map("impuestos")
}

// Un producto puede llevar VARIOS impuestos a la vez: un licor lleva IVA e impuesto al
// consumo simultáneamente, y un solo campo de tarifa no puede representarlo.
model ProductoImpuesto {
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  productoId String
  impuesto   Impuesto @relation(fields: [impuestoId], references: [id], onDelete: Restrict)
  impuestoId String

  @@id([productoId, impuestoId])
  @@index([impuestoId])
  @@map("producto_impuestos")
}

// ============================ Catálogo PUC (referencia global) ============================
// Plan Único de Cuentas. Dos sectores: 'comercial' (Decreto 2650) y 'esal' (entidades sin
// ánimo de lucro / Catálogo de supervisión). Data cargada desde lib/data/puc*.json.
model CuentaPUC {
  id         String  @id @default(cuid())
  sector     String // 'comercial' | 'esal'
  codigo     String
  nombre     String
  clase      String
  nivel      Int
  naturaleza String? // Débito | Crédito
  imputable  Boolean @default(true) // cuenta de detalle (permite movimientos)

  @@unique([sector, codigo])
  @@index([sector])
  @@map("cuentas_puc")
}

// ============================ Asientos contables (partida doble) ============================
model Asiento {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  numero       String
  sector       String  @default("comercial") // PUC usado: comercial | esal
  fecha        String
  descripcion  String
  tipo         String  @default("manual")
  documentoRef String?
  estado       String  @default("registrado") // borrador | registrado

  totalDebitos  Decimal @db.Decimal(18, 2)
  totalCreditos Decimal @db.Decimal(18, 2)
  diferencia    Decimal @default(0) @db.Decimal(18, 2)

  anulado         Boolean @default(false)
  motivoAnulacion String?

  // Contraasiento: qué asiento reversa este. Se enlaza por ID y no por el texto de la
  // descripción — comparar por prefijo hacía que "REV-CP-450" pareciera la reversión de
  // "CP-45", y el segundo asiento se quedaba sin contraasiento y sin documento que lo
  // soportara (art. 124 del Decreto 2649).
  reversaAId     String?
  reversadoPorId String?

  movimientos AsientoMovimiento[]

  @@unique([usuarioId, numero])
  @@index([usuarioId])
  @@map("asientos")
}

model AsientoMovimiento {
  id        String  @id @default(cuid())
  asiento   Asiento @relation(fields: [asientoId], references: [id], onDelete: Cascade)
  asientoId String

  cuenta       String // código PUC
  nombreCuenta String
  debito       Decimal @default(0) @db.Decimal(18, 2)
  credito      Decimal @default(0) @db.Decimal(18, 2)
  tercero      String?

  @@index([asientoId])
  @@map("asiento_movimientos")
}

// ============================ Documento soporte (adquisiciones a no obligados a facturar) ============================
model DocumentoSoporte {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  numero String
  // FECHA DE LA OPERACIÓN, no la del pago. El art. 1.6.1.4.12 del DUT 1625/2016 (adicionado
  // por el Decreto 358 de 2020) exige la fecha en que ocurrió la operación; el pago es un
  // hecho posterior y no la sustituye. De aquí sale la fecha del asiento (devengo).
  fecha  String

  // Snapshot del vendedor EN ESE DOCUMENTO, igual que en `Compra`: el impreso del art.
  // 1.6.1.4.12 no puede cambiar porque el tercero se haya mudado.
  proveedorNombre    String
  proveedorDocumento String?
  concepto           String

  // Identidad consolidada para agrupar y reportar (ver el modelo `Tercero`).
  tercero   Tercero? @relation(fields: [terceroId], references: [id], onDelete: SetNull)
  terceroId String?

  bruto          Decimal @db.Decimal(18, 2)
  porcReteFuente Decimal @default(0) @db.Decimal(6, 3) // porcentaje (%)
  porcReteIca    Decimal @default(0) @db.Decimal(8, 4) // por mil (‰)
  reteFuente     Decimal @default(0) @db.Decimal(18, 2)
  reteIca        Decimal @default(0) @db.Decimal(18, 2)
  neto           Decimal @db.Decimal(18, 2)

  // Sin estos dos, la retención del soporte no se puede certificar: el certificado del
  // Art. 381 agrupa POR CONCEPTO, y el ICA se declara en el municipio donde se practicó.
  conceptoRetencion      String? // id de lib/data/tablaRetefuente.js
  municipioIca           String?
  // Tipo de documento del tercero: el certificado y la exógena identifican por documento.
  proveedorTipoDocumento String?

  estado          String  @default("Emitido") // Emitido | Anulado
  // Como en Factura: sin fecha, un periodo ya declarado deja de ser reproducible.
  fechaAnulacion  String?
  motivoAnulacion String?

  // Asiento que generó al emitirse. `null` = todavía no está en el libro diario, casi siempre
  // porque al emitir faltaba una cuenta del mapa. Esos documentos se listan como "sin
  // contabilizar" y se pueden contabilizar después; no se pierden ni se ocultan.
  asientoId String?

  // Comprobante de egreso desde el que se generó, cuando se usó el atajo.
  //
  // Además de la trazabilidad, es el DISCRIMINADOR DE MODELO y de ahí cuelgan tres reglas:
  //   · null  → modelo clásico: primero se causa el soporte, después se paga. La contrapartida
  //             es PROVEEDORES y la retención del soporte es la que se certifica.
  //   · lleno → el pago ocurrió primero y el soporte lo legaliza. La contrapartida es
  //             ANTICIPOS POR LEGALIZAR (1330) —usar proveedores dejaría un saldo débito
  //             fantasma entre el pago y la legalización— y la retención ya la certificó el
  //             comprobante, así que la del soporte va informativa.
  generadoDesdeComprobanteId String?

  // Lo pagado por comprobantes de egreso. Espejo de `Compra.totalPagado`: se materializa para
  // poder validar el saldo dentro de la transacción y para impedir que se anule un soporte
  // que ya tiene un pago aplicado.
  totalPagado Decimal @default(0) @db.Decimal(18, 2)

  // Adquirente (nosotros) tal como estaba al emitir. La Res. 167/2021 exige identificar al
  // adquirente en el documento soporte, y el impreso no puede depender de la configuración
  // de hoy para un documento de hace dos años.
  emisorSnapshot Json?

  retencionesPracticadas RetencionPracticada[]
  pagos                  ComprobanteAplicacion[] @relation("PagosDeSoporte")

  @@unique([usuarioId, numero])
  @@index([usuarioId])
  @@map("documentos_soporte")
}

model FacturaItem {
  id        String  @id @default(cuid())
  factura   Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  facturaId String

  productoCodigo String?
  descripcion    String
  cantidad       Decimal @db.Decimal(18, 3)
  precioUnitario Decimal @db.Decimal(18, 2)
  descuento      Decimal @default(0) @db.Decimal(18, 2)
  base           Decimal @db.Decimal(18, 2)
  tarifaIva      Decimal @default(0) @db.Decimal(6, 3)
  valorIva       Decimal @default(0) @db.Decimal(18, 2)
  subtotal       Decimal @db.Decimal(18, 2)
  extra          Json?

  // Tratamiento de IVA del renglón. La tarifa numérica NO alcanza: exento, excluido y
  // "emisor no responsable" liquidan los tres a 0 y tienen consecuencias fiscales distintas.
  // 'gravado' | 'exento' | 'excluido' | 'no_responsable' | 'sin_clasificar'
  // 'sin_clasificar' es para los productos con la vieja tarifa "0%", que no es una categoría
  // real: hay que decidir si son exentos o excluidos. Se marcan para poder encontrarlos en
  // vez de adivinar por ellos.
  tipoIva String @default("gravado")

  impuestos FacturaItemImpuesto[]

  @@index([facturaId])
  @@index([facturaId, tipoIva])
  @@map("factura_items")
}

// Un impuesto liquidado sobre un renglón. Es, campo por campo, un `cac:TaxSubtotal` del
// UBL 2.1: base gravable, tarifa (o valor unitario) y valor, bajo un `TaxScheme` con su
// código DIAN. Con esta tabla, emitir la factura electrónica es serializar filas.
//
// Se snapshotean código y nombre del tributo, no solo el `impuestoId`: si mañana cambia la
// tarifa de un impuesto del catálogo, la factura ya emitida debe seguir mostrando la que se
// liquidó. Es la misma razón por la que se snapshotea el emisor y el cliente.
model FacturaItemImpuesto {
  id            String      @id @default(cuid())
  item          FacturaItem @relation(fields: [facturaItemId], references: [id], onDelete: Cascade)
  facturaItemId String

  impuestoId String? // referencia al catálogo; null si el impuesto se eliminó después
  tipo       String // 'IVA' | 'INC' | ...
  codigoDian String
  nombreDian String

  base          Decimal  @db.Decimal(18, 2)
  esNominal     Boolean  @default(false)
  tarifa        Decimal? @db.Decimal(6, 3)
  valorUnitario Decimal? @db.Decimal(18, 2)
  cantidad      Decimal? @db.Decimal(18, 3) // para los nominales por unidad
  valor         Decimal  @db.Decimal(18, 2)

  @@index([facturaItemId])
  @@index([tipo])
  @@map("factura_item_impuestos")
}

// ============================ Nota de contabilidad ============================
// El comprobante de contabilidad del art. 124 del Decreto 2649/1993, para los AJUSTES que no
// tienen documento propio: reclasificaciones, provisiones, depreciación y amortización,
// causación de diferidos, cierres y corrección de errores.
//
// ABSORBE EL ASIENTO MANUAL. Antes se podían crear asientos sueltos desde /asientos-contables;
// un asiento sin documento que lo soporte no cumple el art. 124 (falta el origen y la
// justificación) y no deja rastro de qué periodo se estaba ajustando. Ahora el asiento es la
// CONSECUENCIA de la nota: la nota se emite y genera el asiento, y el libro diario pasa a ser
// de solo lectura.
//
// PREFIJO `CC-` (comprobante de contabilidad). `NC-` ya lo usa la nota crédito.
model NotaContabilidad {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  numero String? // null mientras es borrador: el consecutivo se toma al emitir
  sector String  @default("comercial") // PUC usado: comercial | esal
  fecha  String
  ciudad String?

  // Lo que distingue un AJUSTE de un registro corriente: una nota fechada en enero puede estar
  // ajustando diciembre, y esa diferencia decide en qué periodo pesa el ajuste.
  periodoAfectado String // 'AAAA-MM'
  tipoAjuste      String // ver TIPOS_AJUSTE en lib/notaContabilidadValidation.js

  concepto     String  @db.Text
  documentoRef String?
  anexos       String? @db.Text

  totalDebitos  Decimal @db.Decimal(18, 2)
  totalCreditos Decimal @db.Decimal(18, 2)
  diferencia    Decimal @default(0) @db.Decimal(18, 2)

  // borrador → emitido → reversado. No hay borrado: un comprobante emitido se reversa con otro
  // que invierte los movimientos, igual que los comprobantes de tesorería.
  estado String @default("borrador")

  // El asiento que generó al emitirse. Es la trazabilidad que exige el art. 124.
  asientoId String?

  // Reversión: dos punteros para poder navegar en ambos sentidos sin recorrer la tabla.
  reversaAId      String?
  reversadaPorId  String?
  motivoReversion String?

  elaboradoPor   String?
  elaboradoEn    DateTime @default(now())
  autorizadoPor  String?
  emisorSnapshot Json? // razón social, NIT y dirección tal como estaban al emitir

  movimientos NotaContabilidadMovimiento[]

  @@unique([usuarioId, numero])
  @@index([usuarioId, estado])
  @@index([usuarioId, periodoAfectado])
  @@map("notas_contabilidad")
}

model NotaContabilidadMovimiento {
  id     String           @id @default(cuid())
  nota   NotaContabilidad @relation(fields: [notaId], references: [id], onDelete: Cascade)
  notaId String

  cuenta       String // código PUC
  nombreCuenta String // lo fija el catálogo, no el cliente
  debito       Decimal @default(0) @db.Decimal(18, 2)
  credito      Decimal @default(0) @db.Decimal(18, 2)
  tercero      String?
  detalle      String?
  orden        Int     @default(0)

  @@index([notaId])
  @@map("nota_contabilidad_movimientos")
}
